NODE_ENV=development
PORT=3000
HOST=0.0.0.0
SERVICE_NAME=edge-control-lab
LOG_LEVEL=info

CONTROL_PLANE_DB_HOST=127.0.0.1
CONTROL_PLANE_DB_PORT=5432
CONTROL_PLANE_DB_NAME=platform_control
CONTROL_PLANE_DB_USER=edge-okapi
CONTROL_PLANE_DB_PASSWORD=edge0707
CONTROL_PLANE_DB_SSL=false
TENANT_DB_PASSWORD=edge0707
DATABASE_URL=postgresql://edge-okapi:edge0707@127.0.0.1:5432/platform_control

SECRET_PROVIDER=env
SECRET_ENCRYPTION_KEY=lab-secret-encryption-key-32b

REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DB=0

RABBITMQ_URL=amqp://platform:platform@127.0.0.1:5672
RABBITMQ_EXCHANGE=platform.events
RABBITMQ_CONSUMER_ENABLED=false

SWAGGER_ENABLED=true
METRICS_AUTH_TOKEN=dev-metrics-token
CSRF_ENABLED=false
OTEL_ENABLED=false

KEYCLOAK_ISSUER=http://localhost:8181/realms/platform
KEYCLOAK_JWKS_URI=http://localhost:8181/realms/platform/protocol/openid-connect/certs
KEYCLOAK_AUDIENCE=platform-api
KEYCLOAK_CLIENT_ID=platform-api
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin
KEYCLOAK_ADMIN_ENABLED=true
KEYCLOAK_ADMIN_URL=http://localhost:8181
KEYCLOAK_ADMIN_REALM=platform
KEYCLOAK_ADMIN_CLIENT_ID=platform-admin
KEYCLOAK_ADMIN_CLIENT_SECRET=platform-admin-secret

EDGE_KEYCLOAK_ISSUER=http://localhost:8181/realms/edge-admin
EDGE_KEYCLOAK_JWKS_URI=http://localhost:8181/realms/edge-admin/protocol/openid-connect/certs
EDGE_KEYCLOAK_AUDIENCE=edge-admin-api
EDGE_KEYCLOAK_ADMIN_REALM=edge-admin
EDGE_KEYCLOAK_ADMIN_CLIENT_ID=edge-admin-api
EDGE_KEYCLOAK_ADMIN_CLIENT_SECRET=edge-admin-api-secret

BILLING_PAYMENT_ADAPTER=sandbox
EDGE_P7_PROVISIONING_ADAPTER=lab_bb
EDGE_BB_CONTROL_BASE_URL=http://127.0.0.1:3100
EDGE_BB_CONTROL_TOKEN=lab-token
EDGE_BB_CONTROL_ALLOW_INSECURE_HTTP=true
EDGE_PCI_ALLOW_INSECURE_HTTP=true
EDGE_PCI_TIMEOUT_MS=15000
