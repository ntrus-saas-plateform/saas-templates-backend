# Platform Core Environment Configuration

NODE_ENV=development
PORT=3000
HOST=0.0.0.0
# Optional: fixed public URL for Swagger/banner (overrides HOST+PORT)
# PUBLIC_BASE_URL=http://localhost:3000
SERVICE_NAME=platform-core
LOG_LEVEL=info

# Control plane — local PostgreSQL (host install listens on :5432 by default).
# Set USER/PASSWORD to your local Postgres credentials (Windows installer password).
CONTROL_PLANE_DB_HOST=127.0.0.1
CONTROL_PLANE_DB_PORT=5432
CONTROL_PLANE_DB_NAME=platform_control
CONTROL_PLANE_DB_USER=postgres
CONTROL_PLANE_DB_PASSWORD=postgres
# Optional: tenant DB password when different from control plane (defaults to CONTROL_PLANE_DB_PASSWORD)
# TENANT_DB_PASSWORD=postgres
CONTROL_PLANE_DB_SSL=false

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# RabbitMQ
RABBITMQ_URL=amqp://platform:platform@localhost:5672
RABBITMQ_EXCHANGE=platform.events
# Set true for integration handlers (inbox fanout, push delivery, timelines)
RABBITMQ_CONSUMER_ENABLED=false
RABBITMQ_MAX_RETRIES=3
RABBITMQ_PREFETCH=10

# Observability / ops
METRICS_AUTH_TOKEN=
SWAGGER_ENABLED=false

# Database pool limits
DB_POOL_MAX_TENANTS=100
CONTROL_PLANE_DB_SSL_REJECT_UNAUTHORIZED=true
OUTBOX_POLL_INTERVAL_MS=5000

# Keycloak — single shared realm for all tenants (NOT realm-per-tenant).
# Each tenant has one or more Keycloak Organizations in this realm; isolation uses JWT tenant_id.
# Local Keycloak typically listens on :8181 (docker compose maps :8080 inside the container).
KEYCLOAK_URL=http://localhost:8181
KEYCLOAK_ISSUER=http://localhost:8181/realms/platform
KEYCLOAK_JWKS_URI=http://localhost:8181/realms/platform/protocol/openid-connect/certs
KEYCLOAK_AUDIENCE=platform-api
KEYCLOAK_CLIENT_ID=platform-api
KEYCLOAK_CLIENT_SECRET=platform-api-secret
KEYCLOAK_ADMIN_ENABLED=true
KEYCLOAK_ADMIN_REALM=platform
KEYCLOAK_ADMIN_URL=http://localhost:8181
KEYCLOAK_ADMIN_CLIENT_ID=platform-admin
KEYCLOAK_ADMIN_CLIENT_SECRET=platform-admin-secret
# Master realm bootstrap for `pnpm keycloak:import` (admin console user)
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin
# Token introspection: defaults to false in dev/test, auto-enabled in production when unset.
# Explicitly set to true/false to override.
# KEYCLOAK_TOKEN_INTROSPECTION_ENABLED=true

# Security (optional extra origins; public URL from PORT/HOST is always allowed)
CORS_ORIGINS=http://localhost:4200,http://localhost:3001
RATE_LIMIT_TTL=60
RATE_LIMIT_LIMIT=100
MAX_PAYLOAD_SIZE=1mb

# Database Pool
DB_POOL_MAX=10
DB_POOL_IDLE_TIMEOUT_MS=30000
DB_POOL_CONNECTION_TIMEOUT_MS=5000
DB_STATEMENT_TIMEOUT_MS=30000
DB_POOL_EVICTION_MS=600000
# DB_POOL_MAX_TENANTS=100
# Maximum number of PostgreSQL connections on the server (pg_settings max_connections).
# Validation: DB_POOL_MAX * DB_POOL_MAX_TENANTS must be <= POSTGRES_MAX_CONNECTIONS.
# Default app schema uses 2000 so 10 × 100 pools fit; set to your real Postgres max_connections.
POSTGRES_MAX_CONNECTIONS=2000

# Secrets
# SECRET_PROVIDER=env|local → per-tenant DB passwords in control-plane secret_store (AES-GCM).
# SECRET_PROVIDER=vault → HashiCorp Vault KV v2 (requires VAULT_ADDR + VAULT_TOKEN).
SECRET_PROVIDER=env
# Required in production when using env/local per-tenant secrets (falls back to CONTROL_PLANE_DB_PASSWORD if unset).
# SECRET_ENCRYPTION_KEY=change-me-to-a-long-random-string
# Vault (when SECRET_PROVIDER=vault)
# VAULT_ADDR=http://127.0.0.1:8200
# VAULT_TOKEN=root
# VAULT_KV_MOUNT=secret
# VAULT_NAMESPACE=
# Idempotency
IDEMPOTENCY_TTL_SECONDS=86400

# OpenTelemetry
OTEL_ENABLED=true
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# Invitation email provider (SMTP / Resend). From-address and public app URL are
# per-tenant Settings (notifications.mailFrom, branding.publicAppUrl). These env
# values are platform fallbacks when a tenant has not set them and has no domain.
MAIL_PROVIDER=auto
MAIL_FROM=Atlas <noreply@localhost>
PUBLIC_APP_URL=http://localhost:3001
# Resend HTTP API (https://api.resend.com) — verified domain required in MAIL_FROM
# RESEND_API_KEY=re_xxxxxxxx
# Generic SMTP (works with Resend SMTP too: smtp.resend.com / user=resend / password=API key)
# SMTP_HOST=smtp.resend.com
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USER=resend
# SMTP_PASSWORD=re_xxxxxxxx

# Storage (local | s3). Use s3 with the R2 endpoint for Cloudflare R2.
STORAGE_PROVIDER=local
# S3_BUCKET=platform-files
# S3_REGION=auto
# S3_ENDPOINT=https://<accountid>.r2.cloudflarestorage.com
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_FORCE_PATH_STYLE=true

# CSRF (enable for cookie-based sessions)
CSRF_ENABLED=false

# Domain registry — subdomain provisioning
# When set, tenant provisioning automatically registers a primary subdomain: {slug}.{TENANT_BASE_DOMAIN}
# Example: TENANT_BASE_DOMAIN=example.com → tenant 'acme' gets 'acme.example.com'
# TENANT_BASE_DOMAIN=example.com

# Tenant access policy
# When true, SUSPENDED tenants are allowed read (GET) requests; mutations are still blocked
TENANT_SUSPENDED_ALLOW_READS=false

# Only enable behind a reverse proxy that overwrites/strips client X-Forwarded-Host
TRUST_X_FORWARDED_HOST=false

# Staff push delivery (requires RABBITMQ_CONSUMER_ENABLED=true for workers)
PUSH_DELIVERY_ENABLED=false
# FCM_SERVER_KEY=
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:platform@localhost
# APNS_KEY_ID=
# APNS_TEAM_ID=
# APNS_PRIVATE_KEY=
# APNS_BUNDLE_ID=

# WhatsApp Cloud API / phone KYC OTP (Meta). When WHATSAPP_OTP_ENABLED=false → dry-run (code logged).
WHATSAPP_OTP_ENABLED=false
# WHATSAPP_ACCESS_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_OTP_TEMPLATE_NAME=otp_verification
# WHATSAPP_OTP_TEMPLATE_LANGUAGE=en
# WHATSAPP_OTP_BUTTON_SUBTYPE=none
# WHATSAPP_API_VERSION=v21.0

# Testcontainers (set true to run Docker integration tests)
# TESTCONTAINERS=true
