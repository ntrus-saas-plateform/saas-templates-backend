    "supertest": "^7.0.0",
    "testcontainers": "^10.28.0",
    "tsx": "^4.20.3",
    "typescript": "^6.0.2",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^4.1.2"
  }
