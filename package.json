{
  "name": "platform",
  "version": "0.0.1",
  "description": "Platform Core - Multi-tenant SaaS backend",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "build": "nest build",
    "deploy": "nest deploy",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node --import ./dist/instrumentation.js dist/main.js",
    "lint": "oxlint src/ test/",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "test:architecture": "vitest run --config ./vitest.config.architecture.ts",
    "test:security": "vitest run --config ./vitest.config.security.ts",
    "test:integration": "vitest run --config ./vitest.config.integration.ts",
    "test:edge:db": "vitest run --config ./vitest.config.integration.ts test/integration/edge-db-qualification.spec.ts",
    "test:edge:db:clean": "vitest run --config ./vitest.config.integration.ts test/integration/edge-db-qualification.spec.ts -t \"C — clean install\"",
    "test:edge:db:upgrade": "vitest run --config ./vitest.config.integration.ts test/integration/edge-db-qualification.spec.ts -t \"D — upgrade from 072\"",
    "test:edge:db:integrity": "vitest run --config ./vitest.config.integration.ts test/integration/edge-db-qualification.spec.ts -t \"E — integrity\"",
    "test:e2e": "vitest run --config ./vitest.config.e2e.ts",
    "test:load": "vitest run --config ./vitest.config.load.ts",
    "migrate:control": "node --import tsx scripts/migrate-control-plane.ts",
    "check:sales:migrations": "node --import tsx scripts/check-sales-migrations.ts",
    "check:subscriptions:migrations": "node --import tsx scripts/check-subscription-migrations.ts",
    "check:billing:migrations": "node --import tsx scripts/check-billing-migrations.ts",
    "check:provisioning:migrations": "node --import tsx scripts/check-provisioning-migrations.ts",
    "check:registry:migrations": "node --import tsx scripts/check-registry-migrations.ts",
    "test:edge:provisioning": "vitest run src/modules/edge/domain/provisioning src/modules/edge/infrastructure/provisioning src/modules/edge/application/provisioning src/modules/edge/presentation/controllers/operator-cannot-forge-revocation.spec.ts",
    "test:edge:registry": "vitest run src/modules/edge/domain/registry src/modules/edge/application/registry src/modules/edge/infrastructure/registry",
    "certify:billing": "node --import tsx scripts/certify-billing.ts",
    "migrate:tenant": "node --import tsx scripts/migrate-tenant.ts",
    "migrate:pharmacy-patients": "node --import tsx scripts/migrate-pharmacy-patients-to-customers.ts",
    "db:ensure": "node --import tsx scripts/ensure-dev-databases.ts",
    "seed:dev": "node --import tsx scripts/seed-dev.ts",
    "keycloak:import": "node --import tsx scripts/import-keycloak-realm.ts",
    "seed:local": "node --import tsx scripts/ensure-dev-databases.ts && node --import tsx scripts/migrate-control-plane.ts && node --import tsx scripts/seed-dev.ts && node --import tsx scripts/migrate-tenant.ts aaaaaaaa-aaaa-4aaa-8aaa-aaaaaaaaaaaa && node --import tsx scripts/migrate-tenant.ts bbbbbbbb-bbbb-4bbb-8bbb-bbbbbbbbbbbb && node --import tsx scripts/import-keycloak-realm.ts",
    "seed:edge-e2e": "node --import tsx scripts/seed-edge-e2e.ts",
    "test:edge:marketing": "vitest run src/modules/edge/domain/marketing src/modules/edge/infrastructure/marketing src/modules/edge/application/marketing",
    "test:edge:sales": "vitest run src/modules/edge/domain/sales src/modules/edge/infrastructure/sales",
    "test:edge:sales:db": "vitest run --config ./vitest.config.integration.ts test/integration/edge-sales-db.spec.ts",
    "test:edge:subscriptions": "vitest run src/modules/edge/domain/subscription src/modules/edge/infrastructure/subscription",
    "test:edge:subscriptions:db": "vitest run --config ./vitest.config.integration.ts test/integration/edge-subscription-db.spec.ts",
    "test:edge:billing": "vitest run src/modules/edge/domain/billing src/modules/edge/infrastructure/billing",
    "docs:openapi": "node --import tsx scripts/export-openapi.ts",
    "docs:openapi:static": "node --import tsx scripts/export-openapi-from-source.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.830.0",
    "@aws-sdk/s3-request-presigner": "^3.830.0",
    "@hookform/resolvers": "^5.9.1",
    "@nestjs/common": "^12.0.1",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^12.0.1",
    "@nestjs/platform-express": "^12.0.1",
    "@nestjs/swagger": "^12.0.1",
    "@nestjs/terminus": "^11.0.0",
    "@nestjs/throttler": "^6.4.0",
