{
  "name": "platform",
  "version": "0.0.1",
  "description": "Platform Core - Multi-tenant SaaS backend",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "build": "nest build",
    "deploy": "nest deploy",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node --import ./dist/instrumentation.js dist/main.js",
    "lint": "oxlint src/ test/",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "test:architecture": "vitest run --config ./vitest.config.architecture.ts",
    "test:security": "vitest run --config ./vitest.config.security.ts",
    "test:integration": "vitest run --config ./vitest.config.integration.ts",
    "test:e2e": "vitest run --config ./vitest.config.e2e.ts",
    "test:load": "vitest run --config ./vitest.config.load.ts",
    "migrate:control": "node --import tsx scripts/migrate-control-plane.ts",
    "migrate:tenant": "node --import tsx scripts/migrate-tenant.ts",
    "migrate:pharmacy-patients": "node --import tsx scripts/migrate-pharmacy-patients-to-customers.ts",
    "db:ensure": "node --import tsx scripts/ensure-dev-databases.ts",
    "seed:dev": "node --import tsx scripts/seed-dev.ts",
    "keycloak:import": "node --import tsx scripts/import-keycloak-realm.ts",
    "seed:local": "node --import tsx scripts/ensure-dev-databases.ts && node --import tsx scripts/migrate-control-plane.ts && node --import tsx scripts/seed-dev.ts && node --import tsx scripts/migrate-tenant.ts aaaaaaaa-aaaa-4aaa-8aaa-aaaaaaaaaaaa && node --import tsx scripts/migrate-tenant.ts bbbbbbbb-bbbb-4bbb-8bbb-bbbbbbbbbbbb && node --import tsx scripts/import-keycloak-realm.ts",
    "docs:openapi": "node --import tsx scripts/export-openapi.ts",
    "docs:openapi:static": "node --import tsx scripts/export-openapi-from-source.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.830.0",
