    "@opentelemetry/semantic-conventions": "^1.34.0",
    "@prometheus-io/client": "^0.16.1",
    "@tanstack/react-query": "^5.102.8",
    "@tanstack/react-table": "^9.2.4",
    "amqplib": "^0.10.8",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "clsx": "^2.1.1",
    "compression": "^1.8.0",
    "cookie-parser": "^1.4.7",
    "express": "^5.2.1",
