    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.0",
    "@nestjs/schematics": "^12.0.0",
    "@nestjs/testing": "^12.0.1",
    "@testcontainers/postgresql": "^10.28.0",
    "@testcontainers/rabbitmq": "^12.1.0",
    "@types/amqplib": "^0.10.7",
    "@types/compression": "^1.8.0",
    "@types/cookie-parser": "^1.4.9",
    "@types/express": "^5.0.0",
